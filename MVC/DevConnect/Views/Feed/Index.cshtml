            </section>
            <!-- Fim story -->

            <!-- Inicio seção story -->
            <section id="secao-publicacao">
                <h2>Publicação</h2>
                <form enctype="multipart/form-data" asp-controller="Feed" asp-action="Index" method="post">
                    <textarea name="Descricao" placeholder="Digite a descrição do post..." required></textarea>

                    <footer>
                        <div>
                            <label for="upload" class="file-upload" style="color: #FFFFFF;">Faça upload da sua imagem
                                aqui...</label>
                            <input type="file" id="upload" name="Imagem" hidden>
                        </div>

                        <button type="submit" class="formulario-botao-postar">Postar</button>
                    </footer>
                </form>
            </section>
            <!-- Fim seção story -->

            <!-- Inicio card publi -->
            <section id="publicacoes">
            @foreach (var publi in Model)
            {
                //Só irá exibir publicações que possuem imagens
                if(!string.IsNullOrEmpty(publi.ImagemUrl))
                {
                    <!-- Inicio card publicação -->
                    <article class="card-publi">
                        <header>
                            <a asp-controller="Usuario" asp-action="Perfil">
                                <img    class="foto-perfil"
                                        src="../images/@(publi.IdUsuarioNavigation?.FotoPerfilUrl ?? "davi.jpg")"
                                        alt="Foto de perfil">
                                @publi.IdUsuarioNavigation?.NomeUsuario
                            </a>
                        </header>

                        <figure>
                            <img class="imagem-publi" 
                                 src="../images/@publi.ImagemUrl" 
                                 alt="Imagem da publicacao">

                            <figcaption class="descricao-publicacao">
                                @publi.IdUsuarioNavigation?.NomeUsuario
                                <p>@publi.Descricao</p>
                            </figcaption>

                            <div class="interacoes-publicacao">
                                <button type="button">
                                    <img src="../images/icone-coracao-preto.svg" alt="Curtir">
                                </button>
                                <button type="button">
                                    <img src="../images/icone-comentario-preto.svg" alt="Comentar">
                                </button>

                                <span>100 curtidas</span>
                            </div>
                            

                        </figure>

                        <button type="button">Ver mais comentários...</button>

                    </article>
                    <!-- Fim card publicação -->
                }
                //Só irá exibir publicações que não possuem imagens
                
            }
                
            </section>
            <!-- Fim card publi -->
        </div>
    </main>