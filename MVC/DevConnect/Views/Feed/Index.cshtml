                    </a>
                </article>

                <article class="card-story">
                    <a href="#">
                        <img class="foto-story" src="../images/yuri alberto.jpeg" alt="">
                        <p>yurialberto</p>
                    </a>
                </article>
                <article class="card-story">
                    <a href="#">
                        <img class="foto-story" src="../images/yuri alberto.jpeg" alt="">
                        <p>yurialberto</p>
                    </a>
                </article>
                <article class="card-story">
                    <a href="#">
                        <img class="foto-story" src="../images/traficante.webp" alt="">
                        <p>traficadaquebrada01</p>
                    </a>
                </article>
                <article class="card-story">
                    <a href="#">
                        <img class="foto-story" src="../images/traficante.webp" alt="">
