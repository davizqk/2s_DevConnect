@using Microsoft.Identity.Client
@using Microsoft.IdentityModel.Tokens
@model List<DevConnect.Models.TbPublicacao>

@{
    ViewData["Title"] = "DevConnect - feed";
}


<link rel="stylesheet" href="../css/feed.css">
<link rel="stylesheet" href="../css/global.css">

<script defer>
    const publicacaoNovaCadastrada = "@ViewBag.PublicacaoNovaCadastrada";

    if(publicacaoNovaCadastrada == "Não cadastrado"){
        alert("Usuário não cadastrado! Tente novamente😔");
    } 
    else if(publicacaoNovaCadastrada == "Cadastrada"){
        alert("Muito bem! Sua nova publicação foi postada");
    }
</script>

    <h1>Tela Feed - DevConnect</h1>
    <!-- header -->
    <header id="cabecalho">
        <nav>
            <a id="logo-desktop" asp-controller="Home" asp-action="Index">
                <img src="../images/logo-devconnect-md.svg" alt="Logo da DevConnect" class="imagem">
            </a>

            <a id="logo-mobile" asp-controller="Home" asp-action="Index">
                <img src="../images/logo-devconnect-mob.svg" alt="Logo da DevConnect" class="imagem">
            </a>

            <!-- Ícones -->
            <div class="acoes-cabecalho">
                <a href="#">
                    <img src="../images/coração.svg" alt="Ícone de coração na cor vermelha">
                </a>
                
                <a asp-controller="Home" asp-action="Index">
                    <img src="../images/icone-casa-vermelho.svg" alt="Ícone de casa na cor vermelha">
                </a>


                <a asp-controller="Usuario" asp-action="Perfil">
                    <img class="foto-perfil" src="../images/davi.jpg" alt="Foto de perfil">
                </a>

            </div>
        </nav>
    </header>
    <!-- main -->
    <main>
        <div class="container-flex-publi">
            <!-- Inicio story -->
            <section id="secao-storys">
